/DS <<
/JS (// Fetch the three required input fields\r\nvar qualCoor = this.getField\("txtdivqualcoor"\);\r\nvar qualDate = this.getField\("txtdivqualcoorsigndate"\);\r\nvar imgSig   = this.getField\("imgsigdivcoor"\);\r\n\r\n// Fetch the fields that must remain fillable\r\nvar csdId    = this.getField\("txtcsdid"\);\r\nvar revNo    = this.getField\("txtrevno"\);\r\n\r\n// Determine the filled status of each field\r\nvar isNameFilled = \(qualCoor !== null && qualCoor.valueAsString !== ""\);\r\nvar isDateFilled = \(qualDate !== null && qualDate.valueAsString !== ""\);\r\nvar isSigFilled  = false;\r\n\r\nif \(imgSig !== null\) {\r\n    if \(imgSig.type === "signature" && imgSig.value !== ""\) {\r\n        isSigFilled = true;\r\n    } else if \(imgSig.type === "button" && imgSig.buttonGetIcon\(\) !== null\) {\r\n        isSigFilled = true;\r\n    } else if \(imgSig.valueAsString !== ""\) {\r\n        isSigFilled = true;\r\n    }\r\n}\r\n\r\n// --- EXECUTE LOGIC ONLY IF ALL THREE ARE FILLED ---\r\nif \(isNameFilled && isDateFilled && isSigFilled\) {\r\n    \r\n    // 1. Secure the completed fields by making them read-only and locked\r\n    if \(qualCoor\) {\r\n        qualCoor.readonly = true;\r\n        qualCoor.locked = true;\r\n    }\r\n    if \(qualDate\) {\r\n        qualDate.readonly = true;\r\n        qualDate.locked = true;\r\n    }\r\n    if \(imgSig\) {\r\n        imgSig.readonly = true;\r\n        imgSig.locked = true;\r\n    }\r\n\r\n    // 2. Hide the prompt text and control buttons to clean up the UI\r\n    var elementsToHide = ["txtsigprompt", "txtsigprompt2", "btn_addimg", "btn_delimg"];\r\n    for \(var i = 0; i < elementsToHide.length; i++\) {\r\n        var fieldToHide = this.getField\(elementsToHide[i]\);\r\n        if \(fieldToHide\) {\r\n            fieldToHide.display = display.hidden;\r\n        }\r\n    }\r\n\r\n    // 3. Explicitly force the target fields to remain fillable\r\n    if \(csdId\) {\r\n        csdId.locked = false;\r\n        csdId.readonly = false;\r\n    }\r\n    if \(revNo\) {\r\n        revNo.locked = false;\r\n        revNo.readonly = false;\r\n    }\r\n})
/S /JavaScript
>>
/WS <<
/JS (// ==========================================\r\n// PART 1: FINAL SAVE & FLATTEN \(CSD / REV\)\r\n// ==========================================\r\nvar csdId = this.getField\("txtcsdid"\);\r\nvar revNo = this.getField\("txtrevno"\);\r\n\r\nvar isCsdFilled = \(csdId !== null && csdId.valueAsString !== ""\);\r\nvar isRevFilled = \(revNo !== null && revNo.valueAsString !== ""\);\r\n\r\n// If both final fields are filled, execute the final lockdown\r\nif \(isCsdFilled && isRevFilled\) {\r\n    \r\n    // 1. Unlock and remove unnecessary UI elements and prompts so they don't print\r\n    var saveBtn = this.getField\("btn_SaveApproval"\);\r\n    if \(saveBtn\) {\r\n        saveBtn.locked = false;\r\n        saveBtn.readonly = false;\r\n        this.removeField\("btn_SaveApproval"\);\r\n    }\r\n\r\n    var promptCsd = this.getField\("promptcsdid"\);\r\n    if \(promptCsd\) {\r\n        promptCsd.locked = false;\r\n        promptCsd.readonly = false;\r\n        this.removeField\("promptcsdid"\);\r\n    }\r\n\r\n    var promptRev = this.getField\("promptrevno"\);\r\n    if \(promptRev\) {\r\n        promptRev.locked = false;\r\n        promptRev.readonly = false;\r\n        this.removeField\("promptrevno"\);\r\n    }\r\n\r\n    // 2. Flatten the entire document permanently\r\n    this.flattenPages\(\);\r\n    \r\n    // 3. Erase the JavaScript save actions so they never run again\r\n    this.setAction\("WillSave", ""\);\r\n    this.setAction\("DidSave", ""\);\r\n\r\n} \r\n// ==========================================\r\n// PART 2: COORDINATOR VALIDATION\r\n// ==========================================\r\nelse {\r\n    // Fetch the three required input fields\r\n    var qualCoor = this.getField\("txtdivqualcoor"\);\r\n    var qualDate = this.getField\("txtdivqualcoorsigndate"\);\r\n    var imgSig   = this.getField\("imgsigdivcoor"\);\r\n\r\n    // Determine the filled status of each field\r\n    var isNameFilled = \(qualCoor !== null && qualCoor.valueAsString !== ""\);\r\n    var isDateFilled = \(qualDate !== null && qualDate.valueAsString !== ""\);\r\n    var isSigFilled  = false;\r\n\r\n    // Robust check for the signature/image field\r\n    if \(imgSig !== null\) {\r\n        if \(imgSig.type === "signature" && imgSig.value !== ""\) {\r\n            isSigFilled = true;\r\n        } else if \(imgSig.type === "button" && imgSig.buttonGetIcon\(\) !== null\) {\r\n            isSigFilled = true;\r\n        } else if \(imgSig.valueAsString !== ""\) {\r\n            isSigFilled = true;\r\n        }\r\n    }\r\n\r\n    // Tally up how many coordinator fields have been filled\r\n    var filledCount = 0;\r\n    if \(isNameFilled\) filledCount++;\r\n    if \(isDateFilled\) filledCount++;\r\n    if \(isSigFilled\)  filledCount++;\r\n\r\n    // --- EXECUTE VALIDATION LOGIC ---\r\n\r\n    // Scenario A: Partial completion \(1 or 2 fields filled\)\r\n    if \(filledCount > 0 && filledCount < 3\) {\r\n        app.alert\({\r\n            cMsg: "Incomplete Approval:\\n\\nPlease complete all three fields \(Name, Date, and Signature\) before saving.",\r\n            cTitle: "Missing Information",\r\n            nIcon: 1 // Error icon\r\n        }\);\r\n        \r\n        // Block the save action\r\n        event.rc = false; \r\n    } \r\n    // Scenario B: Full completion \(All 3 fields filled\)\r\n    else if \(filledCount === 3\) {\r\n        var response = app.alert\({\r\n            cMsg: "Divisional Coordinator:\\n\\nPlease confirm that your Name, Date of Signing, and Uploaded Signature are accurate.\\n\\nAre you ready to proceed and save this file? \(This will lock your approval fields\)",\r\n            cTitle: "Confirm Signature Details",\r\n            nIcon: 2, // Question icon\r\n            nType: 2  // Yes/No buttons\r\n        }\);\r\n\r\n        // If the user clicks "No" \(Acrobat assigns 3 to No, 4 to Yes\)\r\n        if \(response !== 4\) {\r\n            app.alert\({\r\n                cMsg: "Save cancelled. You may now correct your information.",\r\n                cTitle: "Action Aborted",\r\n                nIcon: 3 // Info icon\r\n            }\);\r\n            \r\n            // Block the save action\r\n            event.rc = false; \r\n        }\r\n    }\r\n    // Scenario C: 0 fields filled \r\n    // \(The script does nothing, allowing the document to save normally for other users\)\r\n})
/S /JavaScript
>>
